# Create a bot at https://discord.com/developers/applications and paste its token here.
DISCORD_TOKEN=put_your_bot_token_here
DISCORD_CLIENT_ID=put_your_application_client_id_here

# Recommended for your one-server setup: set this to your target server ID.
# Guild-scoped commands appear immediately and replace stale commands in that server.
# Leave empty only when you intentionally want global commands (propagation can take time).
DEV_GUILD_ID=

# Prefix used when a server has not changed its prefix yet.
DEFAULT_PREFIX=!

# SQLite database location. Keep this file persistent on AWS.
DB_PATH=./data/xpbot.sqlite

# Optional: set to true to log additional debug information.
DEBUG=false
